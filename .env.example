# Polymarket Trading Bot - Environment Variables
# Copy this to .env and fill in your values

# Your Polygon wallet private key (from MetaMask export)
POLYGON_PRIVATE_KEY=your_private_key_here

# Your Polymarket proxy wallet address (shown in Polymarket deposit page)
PROXY_WALLET=your_proxy_wallet_here

# Builder API credentials (for auto-redemption of winning positions)
# Get these from: https://builder.polymarket.com
BUILDER_KEY=your_builder_key
BUILDER_SECRET=your_builder_secret
BUILDER_PASSPHRASE=your_builder_passphrase
